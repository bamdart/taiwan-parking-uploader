# =============================================================
# taiwan-parking-uploader 設定範本
# 複製本檔為 .env 後填入實際值（首次啟動的設定精靈也會自動產生 .env）
# .env 已被 .gitignore 忽略，帳密不會進入版本控制。
# =============================================================

# 目前使用的縣市：填縣市 key（taichung / newTaipei）或 ALL
#   ALL 會同時顯示所有縣市，僅供開發測試；正式使用建議指定單一縣市
ACTIVE_CITY=taichung

# -------------------------------------------------------------
# 臺中市交通局 SOAP API（帳密由主管機關提供，需固定 IP 白名單）
# -------------------------------------------------------------
TAICHUNG_ENDPOINT=https://tcgis.taichung.gov.tw/PMOTC/ParkingLotsWcf/ParkingLots.svc
TAICHUNG_ACCOUNT=
TAICHUNG_PASSWORD=

# -------------------------------------------------------------
# 新北市交通局即時車位上傳 SOAP API（帳密由主管機關提供）
# -------------------------------------------------------------
NEWTAIPEI_ENDPOINT=https://www.parkinginfo.ntpc.gov.tw/ReNewParkingInfo/ReNewInfo.asmx
NEWTAIPEI_USER_ID=
NEWTAIPEI_USER_PWD=
NEWTAIPEI_PARKING_LOT_ID=

# -------------------------------------------------------------
# 介面設定
# -------------------------------------------------------------
# 字體大小（standard / large / xlarge）
FONT_SIZE=standard
# 主題（system / light / dark）
THEME=system

# 註：log 保留天數由 schedule.json 的 logRetentionDays 控制（預設 90 天）。
